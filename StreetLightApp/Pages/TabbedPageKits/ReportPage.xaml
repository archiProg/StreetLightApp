<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StreetLightApp.Pages.TabbedPageKits.ReportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctrl="clr-namespace:StreetLightApp.Controls"
    Title="Report"
    BackgroundColor="#F2F2F2"
    NavigationPage.HasNavigationBar="False">
    <Grid RowDefinitions="Auto,*">
        <Border
            Grid.Row="0"
            BackgroundColor="#FFFFFF"
            HeightRequest="56"
            Stroke="Transparent"
            StrokeShape="RoundRectangle 0,0,8,8"
            StrokeThickness="0">
            <Label
                Margin="16,0,0,0"
                FontFamily="PoppinsSemiBold"
                FontSize="18"
                Text="Report"
                VerticalOptions="Center" />
        </Border>
        <Grid
            x:Name="LogDetail"
            Grid.Row="1"
            RowDefinitions="Auto,*"
            RowSpacing="16">
            <ScrollView Grid.Row="1">
                <StackLayout
                    x:Name="sitePanel"
                    Padding="8,0,8,34"
                    Spacing="8" />
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>