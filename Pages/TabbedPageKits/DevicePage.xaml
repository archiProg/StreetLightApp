<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StreetLightApp.Pages.TabbedPageKits.DevicePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:StreetLightApp.Views"
    Title="Devices List"
    BackgroundColor="#F2F2F2"
    NavigationPage.HasNavigationBar="false">
    <!--<NavigationPage.TitleView>
        <Grid Padding="10">
            <Label
                FontAttributes="Bold"
                FontSize="18"
                HorizontalOptions="Center"
                Text="My Site"
                TextColor="DarkSlateBlue"
                VerticalOptions="Center" />
        </Grid>
    </NavigationPage.TitleView>-->
    <Grid RowDefinitions="Auto,*" RowSpacing="16">
        <Border
            Grid.Row="0"
            BackgroundColor="#FFFFFF"
            HeightRequest="56"
            Stroke="Transparent"
            StrokeShape="RoundRectangle 0,0,8,8"
            StrokeThickness="0">
            <Label
                Margin="16,0,0,0"
                FontFamily="PoppinsSemiBold"
                FontSize="18"
                Text="My Site"
                VerticalOptions="Center" />
        </Border>
        <ScrollView Grid.Row="1">
            <StackLayout
                x:Name="sitePanel"
                Padding="8,0,8,34"
                Spacing="8" />
        </ScrollView>
        <Border
            x:Name="indicatorView"
            Padding="64"
            BackgroundColor="{DynamicResource PrimaryTextColor}"
            HorizontalOptions="Fill"
            IsVisible="True"
            Opacity="0.5"
            StrokeShape="RoundRectangle 0"
            VerticalOptions="Fill" />
        <Border
            x:Name="indicator"
            Padding="64"
            BackgroundColor="{DynamicResource PrimaryColor}"
            HorizontalOptions="Center"
            IsVisible="True"
            StrokeShape="RoundRectangle 16"
            VerticalOptions="Center">
            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="True"
                VerticalOptions="Center"
                Color="Red" />
        </Border>
    </Grid>

</ContentPage>