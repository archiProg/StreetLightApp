<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StreetLightApp.Pages.TabbedPageKits.SettingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Setting"
    BackgroundColor="#FFFFFF"
    NavigationPage.HasNavigationBar="False">
    <Grid Padding="16" RowDefinitions="Auto,*">
        <Border
            Grid.Row="0"
            BackgroundColor="#FFFFFF"
            HeightRequest="56"
            Stroke="Transparent"
            StrokeThickness="0">
            <Label
                FontFamily="PoppinsSemiBold"
                FontSize="18"
                Text="Setting"
                VerticalOptions="Center" />
        </Border>
        <Grid
            x:Name="LogDetail"
            Grid.Row="1"
            RowDefinitions="Auto,*"
            RowSpacing="16">
            <ScrollView Grid.Row="1">
                <StackLayout Spacing="8">
                    <Grid Padding="0,0,0,16">
                        <HorizontalStackLayout Spacing="8">
                            <Border
                                HeightRequest="56"
                                StrokeShape="RoundRectangle 56"
                                WidthRequest="56">
                                <Image
                                    x:Name="avatarProfile"
                                    Aspect="AspectFill"
                                    Source="useravatar.png" />
                            </Border>
                            <StackLayout VerticalOptions="Center">
                                <Label x:Name="profileNameLbl" Text="Welcome" />
                                <Label x:Name="profileUsernameLbl" Text="Welcome" />
                            </StackLayout>
                        </HorizontalStackLayout>
                    </Grid>
                    <Grid HeightRequest="56">
                        <Button
                            BackgroundColor="#F4F6FA"
                            CornerRadius="8"
                            HeightRequest="56" />
                        <Border
                            Padding="16,0"
                            InputTransparent="True"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 8"
                            VerticalOptions="Center">
                            <Label Text="My Account" TextColor="Black" />
                        </Border>
                    </Grid>
                    <Grid HeightRequest="56">
                        <Button
                            BackgroundColor="#F4F6FA"
                            CornerRadius="8"
                            HeightRequest="56" />
                        <Border
                            Padding="16,0"
                            InputTransparent="True"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 8"
                            VerticalOptions="Center">
                            <Label Text="Language" TextColor="Black" />
                        </Border>
                    </Grid>
                    <Grid HeightRequest="56">
                        <Button
                            BackgroundColor="#F4F6FA"
                            CornerRadius="8"
                            HeightRequest="56" />
                        <Border
                            Padding="16,0"
                            InputTransparent="True"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 8"
                            VerticalOptions="Center">
                            <Label Text="Privacy &amp; Policy" TextColor="Black" />
                        </Border>
                    </Grid>
                    <Grid HeightRequest="56">
                        <Button
                            BackgroundColor="#F4F6FA"
                            CornerRadius="8"
                            HeightRequest="56" />
                        <Border
                            Padding="16,0"
                            InputTransparent="True"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 8"
                            VerticalOptions="Center">
                            <Label Text="Terms &amp; Conditions" TextColor="Black" />
                        </Border>
                    </Grid>
                    <Grid Margin="0,24" HeightRequest="56">
                        <Button
                            BackgroundColor="#F4F6FA"
                            CornerRadius="8"
                            HeightRequest="56" />
                        <Border
                            Padding="16,0"
                            InputTransparent="True"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 8"
                            VerticalOptions="Center">
                            <Label Text="Logout" TextColor="red" />
                        </Border>
                    </Grid>
                </StackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>