<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StreetLightApp.Pages.Log.LogSitePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="LogSitePage">
    <Grid>
        <Grid RowDefinitions="Auto,*">
            <Grid
                Grid.Row="0"
                Padding="0,8,0,0"
                HorizontalOptions="Center">
                <Border
                    Padding="4"
                    BackgroundColor="#F1F5F9"
                    Stroke="#F1F5F9"
                    StrokeShape="RoundRectangle 100"
                    WidthRequest="165">
                    <HorizontalStackLayout Spacing="4">
                        <Button
                            x:Name="Select_Report"
                            BackgroundColor="White"
                            Clicked="Select_Report_Clicked"
                            CornerRadius="96"
                            MaximumHeightRequest="40"
                            Text="Report"
                            TextColor="Black"
                            WidthRequest="75" />
                        <Button
                            x:Name="Select_Log"
                            BackgroundColor="#F1F5F9"
                            Clicked="Select_Log_Clicked"
                            CornerRadius="96"
                            MaximumHeightRequest="40"
                            Text="Log"
                            TextColor="#8B9DB2"
                            WidthRequest="75" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
            <Grid
                x:Name="AllReportDetail"
                Grid.Row="1"
                RowDefinitions="Auto,*">
                <Grid Grid.Row="0" Padding="16,8,16,8">
                    <HorizontalStackLayout Spacing="16">
                        <RadioButton
                            x:Name="RadioButtonMaintenace"
                            CheckedChanged="RadioButtonMaintenace_CheckedChanged"
                            Content="Maintenace"
                            GroupName="Fruits"
                            Value="Apple" />
                        <RadioButton
                            x:Name="RadioButtonDevice"
                            Grid.Row="1"
                            CheckedChanged="RadioButtonDevice_CheckedChanged"
                            Content="Device"
                            GroupName="Fruits"
                            Value="Apple" />
                    </HorizontalStackLayout>

                </Grid>
                <StackLayout
                    x:Name="ReportDetail"
                    Grid.Row="1"
                    IsVisible="false">
                    <Grid Padding="16,8,16,8" ColumnDefinitions="*,*">
                        <StackLayout Grid.Column="0">
                            <Label Text="Gateway" />
                            <Grid Padding="0,4,8,0">
                                <Border
                                    InputTransparent="True"
                                    Stroke="#F1F5F9"
                                    StrokeShape="RoundRectangle 8">
                                    <Grid>
                                        <Image
                                            Margin="0,0,16,0"
                                            HeightRequest="16"
                                            HorizontalOptions="End"
                                            Source="pick_icon.png" />
                                    </Grid>
                                </Border>
                                <Picker
                                    x:Name="GatewayPickReport"
                                    Opacity="0.5"
                                    SelectedIndexChanged="GatewayPickReport_SelectedIndexChanged" />
                            </Grid>
                        </StackLayout>
                        <StackLayout Grid.Column="1">
                            <Label Text="Device" />
                            <Grid Padding="0,4,0,0">
                                <Border
                                    InputTransparent="True"
                                    Stroke="#F1F5F9"
                                    StrokeShape="RoundRectangle 8">
                                    <Grid>
                                        <Image
                                            Margin="0,0,16,0"
                                            HeightRequest="16"
                                            HorizontalOptions="End"
                                            Source="pick_icon.png" />
                                    </Grid>
                                </Border>
                                <Picker
                                    x:Name="DevicePickReport"
                                    Opacity="0.5"
                                    SelectedIndexChanged="DevicePickReport_SelectedIndexChanged" />
                            </Grid>
                        </StackLayout>

                    </Grid>
                    <StackLayout
                        x:Name="MaintenaceDetail"
                        Grid.Column="1"
                        IsVisible="false" />
                    <StackLayout
                        x:Name="DeviceDetail"
                        Grid.Column="1"
                        IsVisible="true">
                        <Grid Padding="16,8,16,0" ColumnDefinitions="*,*">
                            <StackLayout Grid.Column="0">
                                <Label Text="From" />
                                <Grid Padding="0,4,8,0">
                                    <Border
                                        InputTransparent="True"
                                        Stroke="#F1F5F9"
                                        StrokeShape="RoundRectangle 8" />
                                    <Grid>
                                        <DatePicker
                                            x:Name="StartDatePickerReport"
                                            DateSelected="DateStartPickerReport_DateSelected"
                                            Format="dd/M/yyyy" />
                                    </Grid>
                                </Grid>

                            </StackLayout>
                            <StackLayout Grid.Column="1">
                                <Label Text="To" />
                                <Grid Padding="0,4,0,0">
                                    <Border
                                        InputTransparent="True"
                                        Stroke="#F1F5F9"
                                        StrokeShape="RoundRectangle 8" />
                                    <Grid>
                                        <DatePicker
                                            x:Name="EndDatePickerReport"
                                            DateSelected="DateEndPickerReport_DateSelected"
                                            Format="dd/M/yyyy" />
                                    </Grid>
                                </Grid>
                            </StackLayout>
                        </Grid>
                        <!--<HorizontalStackLayout Padding="8,0" Spacing="8">
                            <HorizontalStackLayout>
                                <CheckBox x:Name="CheckBoxRepair" CheckedChanged="CheckBoxRepair_CheckedChanged" />
                                <Label Text="Repair" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout>
                                <CheckBox x:Name="CheckBoxInspection" CheckedChanged="CheckBoxInspection_CheckedChanged" />
                                <Label Text="Inspection" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>-->
                    </StackLayout>
                    <Button
                        x:Name="SearchButtonReport"
                        Margin="16,8,16,8"
                        Padding="16,0,16,0"
                        BackgroundColor="#316BF7"
                        Clicked="OnSearchButtonClicked"
                        CornerRadius="8"
                        FontFamily="PoppinsMedium"
                        HeightRequest="42"
                        Text="Search"
                        TextColor="#FFFFFF" />
                </StackLayout>
            </Grid>
            <Grid
                x:Name="LogDetail"
                Grid.Row="1"
                IsVisible="false">
                <StackLayout Padding="16">
                    <Grid ColumnDefinitions="*,*">
                        <StackLayout Grid.Column="0">
                            <Label Text="Member" />
                            <Grid Padding="0,4,8,0">
                                <Border
                                    InputTransparent="True"
                                    Stroke="#F1F5F9"
                                    StrokeShape="RoundRectangle 8">
                                    <Grid>
                                        <Image
                                            Margin="0,0,16,0"
                                            HeightRequest="16"
                                            HorizontalOptions="End"
                                            Source="pick_icon.png" />
                                    </Grid>
                                </Border>
                                <Picker
                                    x:Name="MemberPick"
                                    Opacity="0.5"
                                    SelectedIndexChanged="MemberPick_SelectedIndexChanged" />
                            </Grid>

                        </StackLayout>
                        <StackLayout Grid.Column="1">
                            <Label Text="Gateway" />
                            <Grid Padding="0,4,8,0">
                                <Border
                                    InputTransparent="True"
                                    Stroke="#F1F5F9"
                                    StrokeShape="RoundRectangle 8">
                                    <Grid>
                                        <Image
                                            Margin="0,0,16,0"
                                            HeightRequest="16"
                                            HorizontalOptions="End"
                                            Source="pick_icon.png" />
                                    </Grid>
                                </Border>
                                <Picker
                                    x:Name="GatewayPick"
                                    Opacity="0.5"
                                    SelectedIndexChanged="GatewayPick_SelectedIndexChanged" />
                            </Grid>
                        </StackLayout>
                    </Grid>
                    <Grid Padding="0,8,0,0" ColumnDefinitions="*,*">
                        <StackLayout Grid.Column="0">
                            <Label Text="Device" />
                            <Grid Padding="0,4,8,0">
                                <Border
                                    InputTransparent="True"
                                    Stroke="#F1F5F9"
                                    StrokeShape="RoundRectangle 8">
                                    <Grid>
                                        <Image
                                            Margin="0,0,16,0"
                                            HeightRequest="16"
                                            HorizontalOptions="End"
                                            Source="pick_icon.png" />
                                    </Grid>
                                </Border>
                                <Picker
                                    x:Name="DevicePick"
                                    Opacity="0.5"
                                    SelectedIndexChanged="DevicePick_SelectedIndexChanged" />
                            </Grid>

                        </StackLayout>
                        <StackLayout Grid.Column="1">
                            <Label Text="Type" />
                            <Grid Padding="0,4,8,0">
                                <Border
                                    InputTransparent="True"
                                    Stroke="#F1F5F9"
                                    StrokeShape="RoundRectangle 8">
                                    <Grid>
                                        <Image
                                            Margin="0,0,16,0"
                                            HeightRequest="16"
                                            HorizontalOptions="End"
                                            Source="pick_icon.png" />
                                    </Grid>
                                </Border>
                                <Picker
                                    x:Name="TypePick"
                                    Opacity="0.5"
                                    SelectedIndexChanged="TypePick_SelectedIndexChanged" />
                            </Grid>
                        </StackLayout>
                    </Grid>
                    <Grid Padding="0,8,0,0" ColumnDefinitions="*,*">
                        <StackLayout Grid.Column="0">
                            <Label Text="From" />
                            <Grid Padding="0,4,8,0">
                                <Border
                                    InputTransparent="True"
                                    Stroke="#F1F5F9"
                                    StrokeShape="RoundRectangle 8" />
                                <Grid>
                                    <DatePicker
                                        x:Name="StartDatePicker"
                                        DateSelected="DateStartPicker_DateSelected"
                                        Format="dd/M/yyyy" />
                                </Grid>
                            </Grid>

                        </StackLayout>
                        <StackLayout Grid.Column="1">
                            <Label Text="To" />
                            <Grid Padding="0,4,8,0">
                                <Border
                                    InputTransparent="True"
                                    Stroke="#F1F5F9"
                                    StrokeShape="RoundRectangle 8" />
                                <Grid>
                                    <DatePicker
                                        x:Name="EndDatePicker"
                                        DateSelected="DateEndPicker_DateSelected"
                                        Format="dd/M/yyyy" />
                                </Grid>
                            </Grid>
                        </StackLayout>
                    </Grid>
                    <Button
                        Margin="0,16,0,0"
                        Clicked="Button_Clicked"
                        Text="Report" />
                </StackLayout>

            </Grid>
        </Grid>

        <Grid
            x:Name="indicator"
            BackgroundColor="#60000000"
            InputTransparent="False"
            IsVisible="false">
            <Border
                Padding="64"
                BackgroundColor="White"
                HorizontalOptions="Center"
                StrokeShape="RoundRectangle 16"
                VerticalOptions="Center">
                <ActivityIndicator
                    HorizontalOptions="Center"
                    IsRunning="True"
                    VerticalOptions="Center"
                    Color="Red" />
            </Border>
        </Grid>
    </Grid>
</ContentPage>