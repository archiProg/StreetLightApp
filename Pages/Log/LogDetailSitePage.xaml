<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StreetLightApp.Pages.Log.LogDetailSitePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Log">
    <Grid>
        <Grid RowDefinitions="Auto,*">
            <Grid
                Grid.Row="0"
                Padding="16"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="8"
                HorizontalOptions="Start"
                VerticalOptions="Start">
                <Grid Grid.Column="0" Padding="0,8,4,0">
                    <Image
                        HeightRequest="24"
                        HorizontalOptions="Start"
                        Source="search_icon.png"
                        VerticalOptions="Start"
                        WidthRequest="24" />
                </Grid>
                <StackLayout Grid.Column="1">
                    <Label
                        x:Name="deviceName"
                        FontFamily="PoppinsSemiBold"
                        FontSize="18" />
                    <Label
                        x:Name="TypeName"
                        FontSize="14"
                        Text="Type: Usage"
                        TextColor="#627296" />
                    <Label
                        x:Name="TimeSearch"
                        FontSize="14"
                        Text="22-05-2025  to 22-05-2025"
                        TextColor="#627296" />
                </StackLayout>
            </Grid>
            <CollectionView x:Name="LogListView" Grid.Row="1">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <StackLayout>
                            <StackLayout Margin="5" Padding="10">
                                <HorizontalStackLayout>
                                    <Label Text="{Binding member_name, TargetNullValue=Gateway, FallbackValue=Gateway}" />
                                    <Label Text=" #" />
                                    <Label IsVisible="{Binding member_id, Converter={StaticResource NullToBoolConverter}, ConverterParameter=notnull}" Text="{Binding member_id}" />
                                    <Label IsVisible="{Binding member_id, Converter={StaticResource NullToBoolConverter}, ConverterParameter=null}" Text="{Binding gateway_id}" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding created_at, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" TextColor="#627296" />
                                <HorizontalStackLayout>
                                    <Label Text="From" TextColor="#627296" />
                                    <Label Text="[" TextColor="#627296" />
                                    <Label Text="{Binding gateway_id}" TextColor="#627296" />
                                    <Label Text="]" TextColor="#627296" />
                                    <Label Text=" | " TextColor="#627296" />
                                    <Label Text="Device: " TextColor="#627296" />
                                    <Label Text="{Binding device_id}" TextColor="#627296" />
                                    <Label Text=", Ctrl: " TextColor="#627296" />
                                    <Label Text="{Binding control_id}" TextColor="#627296" />
                                    <Label Text=", V: " TextColor="#627296" />
                                    <Label Text="{Binding last_value}" TextColor="#627296" />
                                </HorizontalStackLayout>
                            </StackLayout>
                            <Border HeightRequest="0.5" Stroke="#F4F7FA" />
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>